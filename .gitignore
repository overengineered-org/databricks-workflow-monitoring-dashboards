# Local Python environments and tool caches are never repository inputs.
.venv/
__pycache__/
.ruff_cache/
# Local Databricks state, including the saved SQL warehouse per target.
.databricks/
# A killed select-jobs run can leave its temporary config copy.
.workflow-monitoring.*.yml
# Personal agent instructions, for example an import of docs/maintainers.md.
CLAUDE.local.md
AGENTS.override.md
