bundle:
  name: "{{.project_name}}"
  # Keep local, Act, and deployment behavior on the reviewed CLI generation.
  databricks_cli_version: ">= 1.13.0"

# Keep resource definitions small by storing each resource in resources/.
include:
  - resources/*.yml

# The warehouse is BYO and required at command time. No workspace-specific ID
# or Databricks profile is stored in this public bundle.
variables:
  warehouse_id:
    description: SQL warehouse ID used by the dashboard
  catalog:
    description: Unity Catalog catalog for collector tables
    default: "{{.catalog}}"
  schema:
    description: Unity Catalog schema for collector tables
    default: "{{.schema}}"
  create_catalog_and_schema_if_missing:
    description: Create the configured catalog and schema when the collector starts
    default: '{{ if eq .create_catalog_and_schema_if_missing "yes" }}true{{ else }}false{{ end }}'
  dashboard_display_name:
    description: Deployed dashboard display name
    default: Databricks Workflow Monitoring Dashboard
  dashboard_viewer_group:
    description: Databricks group granted CAN_READ
    default: "{{.dashboard_viewer_group}}"

targets:
  # Development mode adds the standard Databricks development safeguards.
  dev:
    default: true
    mode: development
  # Production uses one stable path for each user, bundle, and target.
  prod:
    mode: production
    presets:
      trigger_pause_status: UNPAUSED
    workspace:
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
