{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/overengineered-org/databricks-workflow-monitoring-dashboards/src/workflow-monitoring.schema.json",
  "$comment": "This schema powers editor completion and the frequency-specific field rules. Python checks only the IANA timezone and the duplicate job IDs.",
  "title": "Databricks workflow monitoring configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default_timezone", "workflows"],
  "properties": {
    "version": { "const": 3, "description": "Configuration format version." },
    "default_timezone": {
      "type": "string",
      "minLength": 1,
      "description": "Default IANA timezone for SLA deadlines."
    },
    "workflows": {
      "type": "array",
      "description": "Configured Databricks jobs. Only active entries are monitored.",
      "items": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "monitoring_status", "sla"],
      "properties": {
        "job_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Stable Databricks job ID polled by the collector."
        },
        "monitoring_status": {
          "enum": ["active", "inactive"],
          "description": "Include or exclude this job without deleting its configuration."
        },
        "sla": {
          "$ref": "#/$defs/sla",
          "description": "Expected completion schedule for this workflow."
        }
      }
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frequency", "completion_time"],
      "properties": {
        "frequency": {
          "enum": ["daily", "weekly", "fortnightly", "monthly"],
          "description": "How often a successful workflow completion is expected."
        },
        "completion_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Deadline time in 24-hour HH:MM format."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "Optional IANA timezone. Uses default_timezone when omitted."
        },
        "day_of_week": {
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
          "description": "Required only for weekly schedules."
        },
        "first_deadline_date": {
          "type": "string",
          "format": "date",
          "description": "First deadline in a repeating 14-day schedule."
        },
        "day_of_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31,
          "description": "Monthly deadline day. Short months use their final day."
        }
      },
      "$comment": "Each frequency requires its own field and forbids the fields of the other frequencies.",
      "allOf": [
        {
          "if": { "properties": { "frequency": { "const": "daily" } }, "required": ["frequency"] },
          "then": {
            "allOf": [
              { "not": { "required": ["day_of_week"] } },
              { "not": { "required": ["first_deadline_date"] } },
              { "not": { "required": ["day_of_month"] } }
            ]
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "weekly" } }, "required": ["frequency"] },
          "then": {
            "required": ["day_of_week"],
            "allOf": [
              { "not": { "required": ["first_deadline_date"] } },
              { "not": { "required": ["day_of_month"] } }
            ]
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "fortnightly" } }, "required": ["frequency"] },
          "then": {
            "required": ["first_deadline_date"],
            "allOf": [
              { "not": { "required": ["day_of_week"] } },
              { "not": { "required": ["day_of_month"] } }
            ]
          }
        },
        {
          "if": { "properties": { "frequency": { "const": "monthly" } }, "required": ["frequency"] },
          "then": {
            "required": ["day_of_month"],
            "allOf": [
              { "not": { "required": ["day_of_week"] } },
              { "not": { "required": ["first_deadline_date"] } }
            ]
          }
        }
      ]
    }
  }
}
